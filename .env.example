ENV=development
PORT=3005
DAV_API_KEY=
DAV_SECRET_KEY=
DAV_UUID=
DAV_AUTH=
DATABASE_URL=postgresql://user:password@localhost:5432/tripletoy
REDIS_URL=redis://localhost:6379
CACHING=true
# Photos are stored in DigitalOcean Spaces if these are set, otherwise locally in UPLOADS_DIR
# (only for development, the file system of App Platform is lost on every deploy)
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_BUCKET_NAME=
# Region of the bucket (default: fra1)
SPACES_REGION=
UPLOADS_DIR=uploads
# Id of the Toy table of the app in the dav dashboard
DAV_TOY_TABLE_ID=
# Id of the table for the drawings in the dav dashboard (optional, the Toy table is used if empty)
DAV_DRAWING_TABLE_ID=
# Must be the same as WEBHOOK_KEY of dav-api, the webhook url of the app is <api url>/davWebhook
DAV_WEBHOOK_KEY="63b4927a-cd6f-4b48-8186-dd9a0961b484"
# Comma-separated ids of the dav users that are admins, e.g. 12,34. The admins manage the events
# and decide which category a toy belongs to (normal, product, jewelry or drawing)
ADMIN_USER_IDS=
# Public url of the website, used for the links in the emails to the users
WEBSITE_URL=http://localhost:3006
# Public url of this API (product images in the Stripe checkout)
PUBLIC_URL=http://localhost:3005
# Geocoder for the approximate position of the toys on the map (default: OpenStreetMap Nominatim,
# please set a user agent with a contact, see https://operations.osmfoundation.org/policies/nominatim/)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=3pletoy/1.0 (contact@example.com)
# Emails about new orders and uploaded drawings are sent with Resend to all admins (ADMIN_USER_IDS),
# the addresses come from their dav accounts (nothing is sent if this is empty)
RESEND_API_KEY=
# Sender address, must belong to a domain verified in Resend (default: no-reply@dav-apps.tech)
EMAIL_FROM=
