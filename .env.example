ENV=development
PORT=3005
DAV_API_KEY=
DAV_SECRET_KEY=
DAV_UUID=
DAV_AUTH=
DATABASE_URL=postgresql://user:password@localhost:5432/tripletoy
REDIS_URL=redis://localhost:6379
CACHING=true
UPLOADS_DIR=uploads
# Id of the Toy table of the app in the dav dashboard
DAV_TOY_TABLE_ID=
# Id of the table for the drawings in the dav dashboard (optional, the Toy table is used if empty)
DAV_DRAWING_TABLE_ID=
# Must be the same as WEBHOOK_KEY of dav-api, the webhook url of the app is <api url>/davWebhook
DAV_WEBHOOK_KEY="63b4927a-cd6f-4b48-8186-dd9a0961b484"
# Id of the dav user that owns the fixed products, they are shown separately from the other toys
FIXED_PRODUCTS_USER_ID=
# Id of the dav user that uploads the handmade jewelry for kids. Their toys are shown on the
# jewelry page and not in the other toy lists
JEWELRY_USER_ID=
# Public url of this API (product images in the Stripe checkout)
PUBLIC_URL=http://localhost:3005
# Geocoder for the approximate position of the toys on the map (default: OpenStreetMap Nominatim,
# please set a user agent with a contact, see https://operations.osmfoundation.org/policies/nominatim/)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=3pletoy/1.0 (contact@example.com)
# Emails about new orders and uploaded drawings are sent with Resend (nothing is sent if one of these is empty)
RESEND_API_KEY=
# The address that receives these emails
ADMIN_EMAIL=
# Sender address, must belong to a domain verified in Resend (default: no-reply@dav-apps.tech)
EMAIL_FROM=
