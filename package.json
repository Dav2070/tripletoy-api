{
	"name": "tripletoy-api",
	"version": "1.0.0",
	"main": "dist/server.js",
	"type": "module",
	"scripts": {
		"start": "node dist/server.js",
		"dev": "concurrently \"npm:build:watch\" \"npm:serve:watch\"",
		"build": "prisma generate && tsc",
		"build:watch": "tsc -w",
		"serve:watch": "nodemon dist/server.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"license": "MIT",
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@graphql-tools/schema": "^10.1.1",
		"@graphql-tools/utils": "^12.0.1",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"cors": "^2.8.6",
		"dav-js": "github:dav-apps/dav-js#v3.2.3",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"graphql": "^16.14.2",
		"nodemon": "^3.1.14",
		"redis": "^6.2.1"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"concurrently": "^10.0.5",
		"prisma": "^7.10.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
