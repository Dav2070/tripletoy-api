generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Toy {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique @default(uuid()) @db.VarChar
  userId      BigInt
  title       String   @db.VarChar
  description String?  @db.VarChar
  price       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  soldAt      DateTime?
  photos      ToyPhoto[]
  order       ToyOrder?
}

// The paid dav order of a toy, including the shipping address for the seller
model ToyOrder {
  id        BigInt   @id @default(autoincrement())
  orderUuid String   @unique @db.VarChar
  toyId     BigInt   @unique
  toy       Toy      @relation(fields: [toyId], references: [id], onDelete: Cascade)
  buyerId   BigInt
  price     Int
  name      String   @db.VarChar
  email     String   @db.VarChar
  phone     String?  @db.VarChar
  line1     String   @db.VarChar
  line2     String?  @db.VarChar
  postalCode String  @db.VarChar
  city      String   @db.VarChar
  state     String?  @db.VarChar
  country   String   @db.VarChar
  createdAt DateTime @default(now())
}

model ToyPhoto {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @db.VarChar
  toyId     BigInt
  toy       Toy      @relation(fields: [toyId], references: [id], onDelete: Cascade)
  fileName  String   @db.VarChar
  createdAt DateTime @default(now())

  @@index([toyId])
}

enum DrawingStatus {
  PENDING_PAYMENT
  RECEIVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

// The drawing of a child that is turned into a real toy, the status is changed by the admins
model Drawing {
  id        BigInt        @id @default(autoincrement())
  uuid      String        @unique @default(uuid()) @db.VarChar
  userId    BigInt
  fileName  String        @db.VarChar
  status    DrawingStatus @default(PENDING_PAYMENT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  order     DrawingOrder?

  @@index([userId])
}

// The paid dav order of a drawing, including the shipping address for the finished toy
model DrawingOrder {
  id         BigInt   @id @default(autoincrement())
  orderUuid  String   @unique @db.VarChar
  drawingId  BigInt   @unique
  drawing    Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  buyerId    BigInt
  price      Int
  name       String   @db.VarChar
  email      String   @db.VarChar
  phone      String?  @db.VarChar
  line1      String   @db.VarChar
  line2      String?  @db.VarChar
  postalCode String   @db.VarChar
  city       String   @db.VarChar
  state      String?  @db.VarChar
  country    String   @db.VarChar
  createdAt  DateTime @default(now())
}

// An event in the real world for kids, managed by the admins
model Event {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid()) @db.VarChar
  title       String    @db.VarChar
  description String?   @db.VarChar
  startsAt    DateTime
  endsAt      DateTime?
  // The name of the place, e.g. the name of the museum
  venue       String?   @db.VarChar
  line1       String    @db.VarChar
  postalCode  String    @db.VarChar
  city        String    @db.VarChar
  country     String    @db.VarChar
  // Approximate position of the address, used to show only the events nearby
  latitude    Float
  longitude   Float
  // Link to more information or the tickets
  url         String?   @db.VarChar
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([startsAt])
}

model UserProfile {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique
  // Not used anymore, the age is calculated from birthDate
  age         Int?
  birthDate   DateTime? @db.Date
  description String?  @db.VarChar
  phone       String?  @db.VarChar
  addressName       String?  @db.VarChar
  addressLine1      String?  @db.VarChar
  addressLine2      String?  @db.VarChar
  addressPostalCode String?  @db.VarChar
  addressCity       String?  @db.VarChar
  addressCountry    String?  @db.VarChar
  // Approximate position (postal code area) of the address, used for the map
  latitude          Float?
  longitude         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}
